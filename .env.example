# ─── Mystic Seoul environment variables ───
# Copy this file to ".env" and fill in your real values.
# The site runs in DEMO MODE (simulated payments) until you add a Stripe secret key.

# Server
PORT=3000
# Public base URL of your site (used for Stripe redirect URLs).
# Local: http://localhost:3000   |   Production: https://www.mysticseoul.com
PUBLIC_URL=http://localhost:3000

# ─── Stripe (leave blank to stay in demo mode) ───
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Currency for charges. "krw" charges in Korean won (no decimals).
CURRENCY=krw
